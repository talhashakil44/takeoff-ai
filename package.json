{
  "name": "takeoff-ai",
  "version": "0.1.0",
  "description": "AI-native construction takeoff tool for general contractors",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "bench": "vitest run -c bench/vitest.config.ts bench/run.test.ts",
    "bench:score": "vitest run -c bench/vitest.config.ts bench/score.test.ts",
    "build:artifact": "tsc && vite build && node scripts/artifact-page.mjs",
    "build:web": "tsc && vite build --mode web",
    "deploy:web": "npm run build:web && wrangler pages deploy",
    "desktop": "vite build && electron .",
    "desktop:mac": "tsc && vite build && electron-builder --mac --publish never",
    "desktop:win": "tsc && vite build && electron-builder --win --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/d3-force": "^3.0.10",
    "3d-force-graph": "^1.80.1",
    "d3-force": "^3.0.0",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "umap-js": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Takeoff AI",
  "author": "MMA Construction"
}
